{
  "name": "kritesh-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck:guestbook": "tsc --project tsconfig.guestbook.json",
    "check:guestbook": "npm test && npm run typecheck:guestbook",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "netlify:dev": "npx --yes netlify-cli@latest dev",
    "predeploy": "npm run check:guestbook && npm run build",
    "deploy": "npx --yes netlify-cli@latest deploy --no-build --dir=dist"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.0.0",
    "emailjs-com": "^3.2.0",
    "front-matter": "^4.0.2",
    "github-markdown-css": "^5.8.1",
    "lucide-react": "^0.487.0",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-headings": "^2.0.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.10.1",
    "react-syntax-highlighter": "^16.1.0",
    "react-toggle": "^4.1.3",
    "tailwindcss": "^4.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.0"
  }
}
